{
  "name": "@local/dsh-disk-full-warning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stops the turn and opens a full-screen cleanup dialog when a task fails because the disk is full.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-tool"]
    }
  },
  "dshx": {
    "contributes": {
      "tools": ["warn_disk_full"]
    }
  }
}
